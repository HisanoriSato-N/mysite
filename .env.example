# Gmail OAuth files
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Agent behavior
DATABASE_PATH=data/agent.sqlite3
POLL_INTERVAL_SECONDS=300
MAX_MESSAGES_PER_RUN=10
GMAIL_QUERY=in:inbox newer_than:1d -in:drafts -from:me
DRY_RUN=false

# AI reply drafting
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
RESPONDER_LANGUAGE=auto
RESPONDER_TONE=丁寧で簡潔なビジネス文体
DRAFT_SIGNATURE=

# Optional Slack/Discord-compatible webhook notification
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_CHANNEL_NAME=mail-review
